---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHeading from "../../components/AnimatedHeading.tsx";
import AccountUnavailable from "../../components/AccountUnavailable.astro";
import LoginForm from "../../components/LoginForm.tsx";
import { PUBLIC_ACCOUNT_ENABLED } from "../../lib/publicConfig";
---

<BaseLayout title="Connexion" description="Se connecter à son compte Quintessences.">
  <section class="mx-auto max-w-md px-6 py-20">
    <AnimatedHeading client:load lines={[{ text: "Connexion" }]} />
    <div class="mt-10">
      {PUBLIC_ACCOUNT_ENABLED ? <LoginForm client:load /> : <AccountUnavailable />}
    </div>
  </section>
</BaseLayout>

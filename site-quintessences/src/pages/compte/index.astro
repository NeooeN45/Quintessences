---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHeading from "../../components/AnimatedHeading.tsx";
import AccountUnavailable from "../../components/AccountUnavailable.astro";
import ProfileView from "../../components/ProfileView.tsx";
import { PUBLIC_ACCOUNT_ENABLED } from "../../lib/publicConfig";
---

<BaseLayout title="Compte" description="Votre compte Quintessences.">
  <section class="mx-auto max-w-md px-6 py-20">
    <AnimatedHeading client:load lines={[{ text: "Mon compte" }]} />
    <div class="mt-10">
      {PUBLIC_ACCOUNT_ENABLED ? <ProfileView client:load /> : <AccountUnavailable />}
    </div>
  </section>
</BaseLayout>

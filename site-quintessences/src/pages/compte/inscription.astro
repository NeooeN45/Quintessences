---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHeading from "../../components/AnimatedHeading.tsx";
import RegisterForm from "../../components/RegisterForm.tsx";
---

<BaseLayout title="Créer un compte" description="Créer un compte Quintessences.">
  <section class="mx-auto max-w-md px-6 py-20">
    <AnimatedHeading client:load lines={[{ text: "Créer un" }, { text: "compte" }]} />
    <div class="mt-10">
      <RegisterForm client:load />
    </div>
  </section>
</BaseLayout>

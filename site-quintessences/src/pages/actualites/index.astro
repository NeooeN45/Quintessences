---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { APPS } from "../../lib/apps";

const entries = (await getCollection("actualites")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

function appLabel(slug?: string) {
  return APPS.find((a) => a.slug === slug)?.name;
}
function appAccent(slug?: string) {
  return APPS.find((a) => a.slug === slug)?.accent ?? "var(--color-signature)";
}
---

<BaseLayout title="Actualités" description="Le fil des avancées produit de Quintessences.">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-fg-100)]">Actualités</h1>
    <p class="mt-3 text-[var(--color-fg-400)]">Le fil des avancées produit de l'écosystème Quintessences.</p>

    <ol class="mt-10 space-y-8 border-l border-[var(--color-border)] pl-6">
      {entries.map((entry) => (
        <li class="relative">
          <span
            class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full"
            style={{ background: appAccent(entry.data.app) }}
            aria-hidden="true"
          />
          <time class="text-xs text-[var(--color-fg-500)]" datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
          </time>
          {appLabel(entry.data.app) && (
            <span class="ml-2 rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] text-[var(--color-fg-400)]">
              {appLabel(entry.data.app)}
            </span>
          )}
          <h2 class="mt-1">
            <a href={`/actualites/${entry.slug}/`} class="text-lg font-medium text-[var(--color-fg-100)] hover:underline">
              {entry.data.title}
            </a>
          </h2>
          <p class="mt-1 text-sm text-[var(--color-fg-400)]">{entry.data.summary}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

---
import HeroTitle from "./HeroTitle.tsx";
import AnimatedBackdrop from "./AnimatedBackdrop.astro";
---

<section class="relative overflow-hidden border-b border-[var(--color-border)]">
  <AnimatedBackdrop />
  <div class="relative mx-auto max-w-5xl px-6 pb-20 pt-24 sm:pt-32">
    <p class="eyebrow">Jumeau numérique · environnemental · fédéré</p>

    <div class="mt-6">
      <HeroTitle client:load />
    </div>

    <p class="relative mt-10 max-w-md text-[var(--color-fg-300)]">
      Quintessences qualifie la preuve scientifique, raisonne dessus et laisse
      un forestier décider — un écosystème d'intelligence environnementale
      fondé sur le moteur GSIE.
    </p>

    <div class="relative mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/compte/"
        class="rounded-full px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
        style="background: var(--color-fg-100)"
      >
        Créer un compte
      </a>
      <a
        href="https://docs.quintessences-platform.com"
        class="rounded-full border border-[var(--color-border-strong)] px-5 py-2.5 text-sm font-medium text-[var(--color-fg-200)] transition-colors hover:border-[var(--color-fg-100)]"
      >
        Documentation
      </a>
    </div>
  </div>
</section>

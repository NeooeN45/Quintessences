---
// Fond animé du hero — implémentation originale (dégradés flous en
// dérive lente), pas une reprise de tiers. Pur CSS, aucune dépendance
// JS. Respecte prefers-reduced-motion (SITE-X-002) via le CSS global
// qui neutralise toute animation, et via une pause locale explicite
// ci-dessous en filet de sécurité.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <span class="blob blob-a"></span>
  <span class="blob blob-b"></span>
  <span class="blob blob-c"></span>
</div>

<style>
  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.35;
    will-change: transform;
  }

  .blob-a {
    top: -10%;
    left: 8%;
    width: 34vw;
    height: 34vw;
    background: var(--color-accent);
    animation: drift-a 22s ease-in-out infinite;
  }

  .blob-b {
    top: 5%;
    right: 4%;
    width: 26vw;
    height: 26vw;
    background: var(--color-signature-light);
    animation: drift-b 26s ease-in-out infinite;
  }

  .blob-c {
    bottom: -15%;
    left: 30%;
    width: 22vw;
    height: 22vw;
    background: var(--color-app-flora);
    opacity: 0.18;
    animation: drift-c 30s ease-in-out infinite;
  }

  @keyframes drift-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(4vw, 3vh) scale(1.08); }
  }
  @keyframes drift-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-3vw, 4vh) scale(0.95); }
  }
  @keyframes drift-c {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(2vw, -3vh) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>

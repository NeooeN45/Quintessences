#!/bin/sh
# Quintessences — pre-commit (repo externe) : secrets sur le diff stagé.
# Délègue au diagnostic partagé du repo parent s'il est accessible ;
# sinon repli sur un grep minimal.

DIAG="__DIAG_RELPATH__"

if [ -f "$DIAG" ]; then
  python "$DIAG" --staged --no-report
  STATUS=$?
else
  # Repli autonome : motifs de secrets courants sur les lignes ajoutées.
  git diff --cached -U0 --diff-filter=ACMR | grep -nE '^\+' | grep -nE \
    '(ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9_-]{20}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY)' >/dev/null
  STATUS=$?
  # grep renvoie 0 quand un motif est trouvé → on inverse le sens.
  if [ $STATUS -eq 0 ]; then STATUS=1; else STATUS=0; fi
  if [ $STATUS -ne 0 ]; then
    echo "⚠ diagnostic partagé introuvable ($DIAG) — scan secrets minimal utilisé."
  fi
fi

if [ $STATUS -ne 0 ]; then
  echo "❌ Secret potentiel détecté dans le diff stagé — commit bloqué."
fi
exit $STATUS

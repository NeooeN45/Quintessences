flowchart TD
    V["Vision"] --> C["Constitution<br/>(primauté absolue)"]
    C --> RFC["RFC<br/>(propositions d'évolution)"]
    RFC --> DIR["Directive"]
    DIR --> DEC["Décision<br/>(DEC-xxxxxx)"]

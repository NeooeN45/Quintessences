# Variables d'environnement pour la stack de visualisation (docker-compose.viz.yml)
# Copier vers GSIE/.env et remplacer les valeurs factices.
# Aucune valeur réelle ne doit être commitée dans le dépôt.

# --- Base de données ---
# Compte de lecture seule pour les outils de viz (créé par docker/comptes-de-connexion.sql)
GSIE_VIZ_DB_USER=gsie_viz
GSIE_VIZ_DB_PASSWORD=changer-vers-un-mot-de-passe-fort
GSIE_VIZ_DB_HOST=db
GSIE_DB_NAME=gsie
GSIE_DB_USER=gsie
GSIE_DB_PASSWORD=changer-vers-un-mot-de-passe-fort

# --- Metabase ---
# Clé de chiffrement des identifiants de sources (openssl rand -base64 32)
GSIE_METABASE_ENCRYPTION_KEY=generer-avec-openssl-rand-base64-32
# Compte admin initialisé via API /api/setup
GSIE_METABASE_ADMIN_EMAIL=admin@gsie.local
GSIE_METABASE_ADMIN_PASSWORD=changer-vers-un-mot-de-passe-fort

# --- Apache Superset ---
# Clé secrète pour signer les cookies de session (openssl rand -base64 42)
GSIE_SUPERSET_SECRET_KEY=generer-avec-openssl-rand-base64-42
# Mot de passe du compte admin initialisé via CLI
GSIE_SUPERSET_ADMIN_PASSWORD=changer-vers-un-mot-de-passe-fort

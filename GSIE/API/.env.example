# Variables d'environnement — copier en .env et adapter
# Aucun secret n'est commité (CON-008, global_rules security)
#
# Chiffrement optionnel (audit sécurité P1-1) :
#   python tools/secure_env.py encrypt   # .env → .env.enc (supprime .env)
#   python tools/secure_env.py status    # vérifie l'état
#   python tools/secure_env.py decrypt   # .env.enc → .env (debug temporaire)
# La clé Fernet est stockée hors du repo (~/.config/gsie/env.key).
# L'API auto-déchiffre .env.enc au démarrage si .env est absent.

# Application
GSIE_ENVIRONMENT=development
GSIE_DEBUG=false
GSIE_LOG_LEVEL=INFO
GSIE_GUNICORN_MAX_REQUESTS=5000
GSIE_GUNICORN_MAX_REQUESTS_JITTER=5000
GSIE_GRACEFUL_DRAIN_FILE=/tmp/gsie-draining
# direct en développement ; cloudflare_tunnel sur le serveur publié.
GSIE_EDGE_PROXY_MODE=direct

# API
GSIE_API_V1_PREFIX=/api/v1
GSIE_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://api.quintessences-platform.com","https://quintessences-platform.com","https://www.quintessences-platform.com","https://status.quintessences-platform.com"]
# CORS WebSocket (ADR-007) — en production, lister explicitement les origines
# autorisées. Le wildcard ["*"] est REJETÉ par validate_production_security.
GSIE_WS_ALLOWED_ORIGINS=["*"]
# Limite taille corps de requête (bytes) — défaut 1 MiB
GSIE_MAX_REQUEST_BODY_SIZE=1048576

# Rate limiting (OWASP A07)
GSIE_RATE_LIMIT_ENABLED=true
GSIE_RATE_LIMIT_DEFAULT=60/minute
GSIE_RATE_LIMIT_HEALTH=300/minute
GSIE_RATE_LIMIT_EVALUATE=30/minute
# Stockage du rate limiter — Redis en production pour distribution entre workers
# En développement/test, "memory://" évite la dépendance Redis
GSIE_RATE_LIMIT_STORAGE_URL=memory://
# Registre de rotation JWT — Redis obligatoire en staging/production
GSIE_REFRESH_TOKEN_STORAGE_URL=memory://
# Worker outbox transactionnel (ADR-005)
GSIE_OUTBOX_BATCH_SIZE=100
GSIE_OUTBOX_POLL_INTERVAL_SECONDS=1.0
# Reprise sur echec — voir docs/OUTBOX_EXPLOITATION.md
# Tentatives avant mise en lettre morte (la premiere publication comprise)
GSIE_OUTBOX_MAX_ATTEMPTS=8
# Delai apres le premier echec, puis doublement a chaque tentative
GSIE_OUTBOX_RETRY_BASE_SECONDS=2.0
# Plafond du backoff : un incident long ne repousse pas la reprise a l'infini
GSIE_OUTBOX_RETRY_MAX_SECONDS=300.0
# Amplitude du bruit (fraction du delai) — evite que N workers rejouent ensemble
GSIE_OUTBOX_RETRY_JITTER_RATIO=0.2
GSIE_OUTBOX_HEALTHCHECK_MAX_AGE_SECONDS=30

# Object Storage (ADR-006) — local en développement, S3/MinIO en staging/production
# Le backend local ne nécessite aucune credential et écrit dans data/assets.
GSIE_OBJECT_STORAGE_BACKEND=s3
GSIE_OBJECT_STORAGE_LOCAL_PATH=./data/assets
# Le backend local reste disponible hors Compose en positionnant BACKEND=local.
# Exemple MinIO local : endpoint HTTP autorisé uniquement pour development.
GSIE_OBJECT_STORAGE_S3_ENDPOINT=http://localhost:9000
GSIE_OBJECT_STORAGE_S3_ACCESS_KEY=change-me-in-.env
GSIE_OBJECT_STORAGE_S3_SECRET_KEY=change-me-in-.env
GSIE_OBJECT_STORAGE_S3_REGION=us-east-1
GSIE_OBJECT_STORAGE_S3_BUCKET=gsie-assets
# Obligatoire en staging/production. AES256 ou aws:kms selon le fournisseur.
# Laisser non défini pour MinIO local sans KMS configuré.
# GSIE_OBJECT_STORAGE_S3_SERVER_SIDE_ENCRYPTION=AES256
# Minimum S3 multipart : 5 MiB. 8 MiB limite la mémoire consommée par part.
GSIE_OBJECT_STORAGE_S3_MULTIPART_CHUNK_SIZE=8388608
# Compte administrateur MinIO : uniquement utilisé par minio-init, jamais par
# l'API. Employer deux secrets distincts de ceux du compte applicatif S3.
GSIE_MINIO_ROOT_USER=change-me-in-.env
GSIE_MINIO_ROOT_PASSWORD=change-me-in-.env

# Cloudflare Tunnel — chemin vers un fichier contenant uniquement le token.
# Ne jamais placer le token lui-même dans .env ni dans Git.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare_tunnel_token

# PostgreSQL + PostGIS — secrets à définir dans .env
GSIE_DB_USER=gsie
GSIE_DB_PASSWORD=change-me-in-.env
GSIE_DB_NAME=gsie
# Comptes runtime créés par les scripts d'initialisation PostgreSQL.
GSIE_API_DB_USER=gsie_api
GSIE_API_DB_PASSWORD=change-me-in-.env
GSIE_VIZ_DB_USER=gsie_viz
GSIE_VIZ_DB_PASSWORD=change-me-in-.env

# pgBackRest — sauvegarde PITR (DEC-000037 P0-1, docs/BACKUP_RESTORE.md).
# Passphrase de chiffrement AES-256-CBC du dépôt de sauvegarde. Lue par
# pgbackrest directement depuis l'environnement du conteneur db (jamais
# écrite dans docker/pgbackrest.conf). Générer avec :
#   openssl rand -base64 48
PGBACKREST_REPO1_CIPHER_PASS=change-me-in-.env
GSIE_DATABASE_URL=postgresql+asyncpg://gsie:change-me-in-.env@localhost:5432/gsie
GSIE_DB_POOL_SIZE=5
GSIE_DB_MAX_OVERFLOW=10
GSIE_DB_ECHO=false
GSIE_DB_PGBOUNCER_MODE=false
GSIE_DB_POOL_TIMEOUT=30

# Migrations — désactivées au démarrage ; baseline réservée aux bases neuves
# Les anciennes bases locales Alembic 0001-0013 doivent être recréées.
GSIE_RUN_MIGRATIONS_ON_STARTUP=false

# Redis — secret à définir dans .env
GSIE_REDIS_PASSWORD=change-me-in-.env
GSIE_REDIS_URL=redis://:change-me-in-.env@localhost:6379/0
GSIE_REDIS_MAX_CONNECTIONS=20
# Timeouts Redis (secondes) — évite les requêtes bloquantes (résilience)
GSIE_REDIS_SOCKET_TIMEOUT=5
GSIE_REDIS_CONNECT_TIMEOUT=5
# Cache TTL pour /ready (secondes)
GSIE_HEALTH_CACHE_TTL=5

# Contrôles périodiques Data Registry — un seul worker agit grâce au verrou Redis.
# Laisser désactivé jusqu'au déploiement opérateur du scheduler.
GSIE_DATA_REGISTRY_HEALTH_SCHEDULER_ENABLED=false
GSIE_DATA_REGISTRY_HEALTH_INTERVAL_SECONDS=3600
GSIE_DATA_REGISTRY_HEALTH_TIMEOUT_SECONDS=30
GSIE_DATA_REGISTRY_HEALTH_MAX_CONCURRENCY=1
GSIE_DATA_REGISTRY_HEALTH_MAX_BYTES=1048576
GSIE_DATA_REGISTRY_HEALTH_LOCK_TTL_SECONDS=600

# Auth — JWT RS256
GSIE_JWT_ALGORITHM=RS256
GSIE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
GSIE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
GSIE_JWT_PRIVATE_KEY_PATH=keys/private.pem
GSIE_JWT_PUBLIC_KEY_PATH=keys/public.pem
# Dev login — fermé par défaut; activer uniquement en local development.
GSIE_AUTH_DEV_LOGIN_ENABLED=false
GSIE_AUTH_DEV_USERNAME=admin
GSIE_AUTH_DEV_PASSWORD=change-me-in-.env
# Compte Quintessences local — peut être fermé temporairement sans couper le login
GSIE_AUTH_LOCAL_REGISTRATION_ENABLED=true
# Google OIDC — tableau JSON des client IDs Web/Android acceptés par le backend.
# Vide = bouton annoncé « non configuré » et jetons Google refusés.
GSIE_GOOGLE_OAUTH_CLIENT_IDS=[]
# Vide = réutilise GSIE_REFRESH_TOKEN_STORAGE_URL avec un préfixe distinct.
GSIE_GOOGLE_NONCE_STORAGE_URL=
GSIE_GOOGLE_NONCE_EXPIRE_SECONDS=300
# E-mails transactionnels. En développement Docker, Mailpit est utilisé.
# En staging/production : SMTP obligatoire si l'inscription locale est ouverte,
# avec TLS direct ou STARTTLS. Les identifiants restent dans .env/secret manager.
GSIE_TRANSACTIONAL_EMAIL_MODE=disabled
GSIE_SMTP_HOST=
GSIE_SMTP_PORT=587
GSIE_SMTP_USERNAME=
GSIE_SMTP_PASSWORD=
GSIE_SMTP_USE_TLS=false
GSIE_SMTP_STARTTLS=true
GSIE_EMAIL_SENDER=noreply@quintessences-platform.com
GSIE_IDENTITY_ACTION_CODE_EXPIRE_MINUTES=15
# Cloudflare Turnstile — bot protection. Recuperer site/secret sur dash.cloudflare.com > Turnstile.
GSIE_TURNSTILE_ENABLED=false
GSIE_TURNSTILE_SITE_KEY=
GSIE_TURNSTILE_SECRET_KEY=
# Token statique pour le scraper Prometheus (/metrics). Vide = role admin en prod, public en dev.
GSIE_METRICS_BEARER_TOKEN=
GSIE_ORGANISATION_INVITATION_BASE_URL=http://localhost:4000/invitations/accept
GSIE_ORGANISATION_INVITATION_EXPIRE_HOURS=72
# MFA TOTP (RFC 6238) — issuer affiché dans l'app d'authentification
GSIE_MFA_ENABLED=true
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSIE_MFA_ENCRYPTION_KEY=
GSIE_MFA_ISSUER=Quintessences
GSIE_MFA_TOTP_STEP_SECONDS=30
GSIE_MFA_RECOVERY_CODE_COUNT=10
# Lockout progressif — seuil de tentatives échouées avant blocage temporaire
GSIE_LOCKOUT_MAX_ATTEMPTS=5
GSIE_LOCKOUT_DURATION_MINUTES=15
# Vérification de force mot de passe — HIBP k-anonymity + score zxcvbn
GSIE_PASSWORD_CHECK_HIBP_ENABLED=true
GSIE_PASSWORD_CHECK_ZXCVBN_ENABLED=true
GSIE_PASSWORD_MIN_ZXCVBN_SCORE=3
# OIDC générique — fournisseurs enterprise configurables (Keycloak, Microsoft, etc.)
# Liste JSON : [{"name":"keycloak","issuer":"https://kc.example.com","client_ids":["app1"],"jwks_url":"https://kc.example.com/protocol/openid-connect/certs"}]
# Exemple Keycloak public client PKCE (adapter les URLs et redirect URIs)
GSIE_OIDC_PROVIDERS=[]
# Nonce serveur à usage unique pour le flux OIDC générique (anti-rejeu d'ID token)
GSIE_OIDC_NONCE_STORAGE_URL=
GSIE_OIDC_NONCE_EXPIRE_SECONDS=300
# [{"name":"keycloak","issuer":"https://auth.example.com/realms/quintessences","client_ids":["geosylva-android","gsie-admin-web"],"jwks_url":"https://auth.example.com/realms/quintessences/protocol/openid-connect/certs","authorization_url":"https://auth.example.com/realms/quintessences/protocol/openid-connect/auth","allowed_redirect_uris":["com.quintessences.geosylva:/oauth2redirect","http://localhost:4000/oauth/callback"],"scopes":["openid","profile","email"]}]
# Détection de réutilisation de refresh token
GSIE_REFRESH_TOKEN_REUSE_DETECTION_ENABLED=true
# Stripe Billing — désactivé tant que les clés et Price IDs réels ne sont pas configurés
GSIE_STRIPE_ENABLED=false
GSIE_STRIPE_SECRET_KEY=
GSIE_STRIPE_WEBHOOK_SECRET=
GSIE_STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4000/billing/success
GSIE_STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4000/billing/cancel
GSIE_STRIPE_PORTAL_RETURN_URL=http://localhost:4000/billing
GSIE_STRIPE_PRICE_GEOSYLVA_PRO_MONTHLY=
GSIE_STRIPE_PRICE_QUINTESSENCES_PRO_MONTHLY=
# Google Play Developer API — désactivé par défaut
GSIE_GOOGLE_PLAY_ENABLED=false
GSIE_GOOGLE_PLAY_PACKAGE_NAME=
GSIE_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
GSIE_GOOGLE_PLAY_PRODUCT_GEOSYLVA_PRO=
GSIE_GOOGLE_PLAY_PRODUCT_QUINTESSENCES_PRO=
# Apple App Store Server API — désactivé par défaut
GSIE_APPLE_STORE_ENABLED=false
GSIE_APPLE_STORE_BUNDLE_ID=
GSIE_APPLE_STORE_ISSUER_ID=
GSIE_APPLE_STORE_KEY_ID=
GSIE_APPLE_STORE_PRIVATE_KEY_PATH=
GSIE_APPLE_STORE_ROOT_CERTIFICATES_PATH=[]
GSIE_APPLE_STORE_ENVIRONMENT=sandbox
#
# Production :
#   1. Générer les clés : ./docker/generate-jwt-keys.sh
#   2. GSIE_AUTH_DEV_LOGIN_ENABLED=false
#   3. Stocker les clés dans un secret manager (Vault, AWS SM, etc.)
#   4. Monter keys/ en lecture seule dans le conteneur (docker-compose.yml)
#   5. Déclarer les client IDs Google validés dans GSIE_GOOGLE_OAUTH_CLIENT_IDS
#   6. Configurer le relais SMTP, son chiffrement et l'adresse d'expédition

# Observabilité — OpenTelemetry
GSIE_OTEL_ENABLED=false
GSIE_OTEL_ENDPOINT=http://localhost:4317
GSIE_OTEL_SERVICE_NAME=gsie-api

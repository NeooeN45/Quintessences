---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Connexion">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <div class="flex min-h-screen items-center justify-center bg-bg-000 px-4">
    <div class="w-full max-w-sm">
      <!-- Logo -->
      <div class="mb-8 flex items-center justify-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded bg-accent text-sm font-bold text-white">
          G
        </div>
        <span class="text-lg font-semibold tracking-tight text-fg-100">GSIE Admin</span>
      </div>

      <!-- Card -->
      <div class="rounded-lg border border-border bg-bg-100 p-8">
        <h1 class="text-lg font-semibold text-fg-100">Connexion</h1>
        <p class="mt-1 text-[13px] text-fg-400">
          Authentification JWT RS256 via l'API GSIE.
        </p>

        <form id="login-form" class="mt-6 space-y-4">
          <div>
            <label for="email" class="mb-1.5 block text-[13px] font-medium text-fg-200">
              Adresse e-mail
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full rounded-md border border-border bg-bg-000 px-3 py-2 text-[14px] text-fg-100 placeholder-fg-500 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="vous@exemple.fr"
            />
          </div>

          <div>
            <label for="password" class="mb-1.5 block text-[13px] font-medium text-fg-200">
              Mot de passe
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full rounded-md border border-border bg-bg-000 px-3 py-2 text-[14px] text-fg-100 placeholder-fg-500 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="••••••••"
            />
          </div>

          <div id="mfa-field" class="hidden">
            <label for="mfa-code" class="mb-1.5 block text-[13px] font-medium text-fg-200">
              Code MFA
            </label>
            <input
              type="text"
              id="mfa-code"
              name="mfa-code"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="20"
              class="w-full rounded-md border border-border bg-bg-000 px-3 py-2 text-[14px] text-fg-100 placeholder-fg-500 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="123456"
            />
            <label class="mt-2 flex items-center gap-2 text-xs text-fg-400">
              <input type="checkbox" id="mfa-recovery" name="mfa-recovery" />
              Utiliser un code de récupération
            </label>
          </div>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAEIpP0qaRpOz5IdW"></div>

          <div id="error-msg" class="hidden rounded-md border border-error/30 bg-error-bg px-3 py-2 text-[13px] text-error">
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-md bg-accent px-4 py-2 text-[14px] font-medium text-white transition-colors hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-000 disabled:opacity-50"
          >
            Se connecter
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-xs text-fg-500">
        GSIE — General System Intelligence Engine
      </p>
    </div>
  </div>
</AdminLayout>

<script>
  import { completeMfaLogin, login } from "../lib/api";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-msg") as HTMLDivElement;
  const mfaField = document.getElementById("mfa-field") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  let challengeToken: string | null = null;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorMsg.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = challengeToken ? "Vérification…" : "Connexion…";

    const formData = new FormData(form);
    const email = String(formData.get("email") ?? "");
    const password = String(formData.get("password") ?? "");
    const code = String(formData.get("mfa-code") ?? "").trim();
    const isRecoveryCode = formData.get("mfa-recovery") === "on";

    const turnstileInput = document.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null;
    const turnstileToken = turnstileInput?.value ?? "";

    try {
      if (challengeToken) {
        await completeMfaLogin(challengeToken, code, isRecoveryCode);
      } else {
        const result = await login(email, password, turnstileToken);
        if ("mfa_required" in result) {
          challengeToken = result.challenge_token;
          mfaField.classList.remove("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = "Vérifier le code MFA";
          return;
        }
      }
      window.location.href = "/";
    } catch (error) {
      errorMsg.textContent = error instanceof TypeError
        ? "API indisponible"
        : error instanceof Error ? error.message : "Erreur de connexion";
      errorMsg.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = challengeToken ? "Vérifier le code MFA" : "Se connecter";
    }
  });
</script>

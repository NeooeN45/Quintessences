---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Page introuvable">
  <div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <div class="text-6xl font-bold tabular text-fg-500">404</div>
    <h1 class="mt-4 text-xl font-semibold text-fg-100">Page introuvable</h1>
    <p class="mt-2 max-w-md text-[13px] text-fg-400">
      La page que vous cherchez n'existe pas ou a été déplacée.
      Vérifiez l'URL ou revenez au tableau de bord.
    </p>
    <a
      href="/"
      class="mt-6 rounded-md bg-accent px-4 py-2 text-[14px] font-medium text-white transition-colors hover:bg-accent-hover"
    >
      Retour au tableau de bord
    </a>
  </div>
</AdminLayout>

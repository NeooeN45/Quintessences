---
// PageHeader entreprise — titre + description + actions + méta.
// Usage : <PageHeader title="..." description="..."><Actions slot="actions" /></PageHeader>
const {
  title = "",
  description = "",
  lastUpdated = null as string | null,
} = Astro.props;
---

<div class="mb-6 flex flex-col gap-3 border-b border-border pb-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="flex-1">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold tracking-tight text-fg-100">{title}</h1>
      {lastUpdated && (
        <span class="hidden items-center gap-1 text-[11px] text-fg-500 sm:flex">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          MAJ {lastUpdated}
        </span>
      )}
    </div>
    {description && (
      <p class="mt-1 text-[13px] text-fg-400">{description}</p>
    )}
  </div>
  {Astro.slots.has("actions") && (
    <div class="flex flex-shrink-0 items-center gap-2">
      <slot name="actions" />
    </div>
  )}
</div>

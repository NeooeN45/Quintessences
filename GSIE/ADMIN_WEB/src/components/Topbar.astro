---
// Topbar entreprise — sticky, avec profil user, badge env, search, horloge.
// Style Linear/Vercel Pro : dense, hairline borders, tabular nums.
import { API_URL } from "../lib/api";
import { POLL_INTERVALS } from "../lib/constants";
const { currentPath = "/" } = Astro.props;

const breadcrumbMap: Record<string, string> = {
  "/": "Vue d'ensemble",
  "/health": "Santé système",
  "/resources": "Ressources",
  "/engines": "Moteurs",
  "/knowledge": "Connaissances",
  "/climate": "Climat",
  "/map": "Carte des risques",
  "/activity": "Activité",
  "/audit": "Audit",
  "/gamification": "Engagement",
};
const breadcrumb = breadcrumbMap[currentPath] ?? "404";
---

<header
  id="topbar"
  class="sticky top-0 z-30 flex h-12 items-center gap-3 border-b border-border bg-bg-100/80 px-4 backdrop-blur-md lg:px-6"
>
  {/* Breadcrumb */}
  <nav class="hidden items-center gap-1.5 text-[12px] lg:flex" aria-label="Fil d'Ariane">
    <span class="text-fg-500">GSIE</span>
    <svg class="h-3 w-3 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
    <span class="font-medium text-fg-200">{breadcrumb}</span>
  </nav>

  {/* Mobile breadcrumb */}
  <nav class="flex items-center gap-1.5 text-[12px] lg:hidden" aria-label="Fil d'Ariane">
    <span class="font-medium text-fg-200">{breadcrumb}</span>
  </nav>

  {/* Spacer */}
  <div class="flex-1"></div>

  {/* Global search trigger */}
  <button
    id="topbar-search"
    aria-label="Recherche globale (Cmd+K)"
    class="hidden items-center gap-2 rounded-md border border-border bg-bg-200 px-2.5 py-1 text-[12px] text-fg-400 transition-colors hover:border-border-strong hover:text-fg-200 sm:flex"
  >
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span>Rechercher…</span>
    <kbd class="ml-4 rounded border border-border px-1 py-0.5 text-[10px] text-fg-500" aria-hidden="true">⌘K</kbd>
  </button>

  {/* Environment badge */}
  <div
    id="env-badge"
    class="flex items-center gap-1.5 rounded-md border border-warning/30 bg-warning-bg px-2 py-0.5 text-[11px] font-medium text-warning"
    title="Environnement de développement"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-warning" aria-hidden="true"></span>
    DEV
  </div>

  {/* API status pill */}
  <div
    id="topbar-api-status"
    class="flex items-center gap-1.5 rounded-md border border-border bg-bg-200 px-2 py-0.5 text-[11px] text-fg-400"
    role="status"
    aria-live="polite"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-fg-500" aria-hidden="true"></span>
    <span class="hidden sm:inline">API</span>
    <span id="topbar-api-label" class="text-fg-300">…</span>
  </div>

  {/* Horloge */}
  <div class="hidden items-center gap-1.5 text-[12px] tabular text-fg-400 md:flex">
    <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span id="topbar-clock">—</span>
  </div>

  {/* User menu trigger */}
  <button
    id="user-menu-trigger"
    aria-label="Menu utilisateur"
    aria-haspopup="menu"
    class="flex items-center gap-2 rounded-md border border-border bg-bg-200 py-0.5 pl-0.5 pr-2 transition-colors hover:border-border-strong hover:bg-bg-300"
  >
    <div
      id="user-avatar"
      class="flex h-6 w-6 items-center justify-center rounded bg-accent text-[11px] font-bold text-white"
    >
      ?
    </div>
    <span id="user-name" class="hidden text-[12px] font-medium text-fg-200 sm:inline">—</span>
    <svg class="h-3 w-3 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  {/* User dropdown */}
  <div
    id="user-dropdown"
    class="invisible absolute right-4 top-12 z-50 w-56 translate-y-1 rounded-lg border border-border bg-bg-100 p-1.5 opacity-0 shadow-xl transition-all duration-150"
    role="menu"
    aria-labelledby="user-menu-trigger"
  >
    {/* User info */}
    <div class="border-b border-border px-2 py-2">
      <div id="dd-user-name" class="text-[13px] font-medium text-fg-100">—</div>
      <div id="dd-user-role" class="text-[11px] text-fg-500">—</div>
    </div>

    {/* Menu items */}
    <a href="/" class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-[12px] text-fg-300 transition-colors hover:bg-bg-200 hover:text-fg-100" role="menuitem">
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      Profil
    </a>
    <a href="/audit" class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-[12px] text-fg-300 transition-colors hover:bg-bg-200 hover:text-fg-100" role="menuitem">
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Journal d'audit
    </a>
    <a href={API_URL + "/docs"} target="_blank" rel="noopener" class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-[12px] text-fg-300 transition-colors hover:bg-bg-200 hover:text-fg-100" role="menuitem">
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      API Docs
      <svg class="ml-auto h-3 w-3 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <div class="my-1 border-t border-border"></div>

    <button
      id="dd-theme-toggle"
      class="flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-[12px] text-fg-300 transition-colors hover:bg-bg-200 hover:text-fg-100"
      role="menuitem"
    >
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path id="dd-icon-moon" stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        <path id="dd-icon-sun" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <span id="dd-theme-label">Thème sombre</span>
    </button>

    <div class="my-1 border-t border-border"></div>

    <button
      id="dd-logout"
      class="flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-[12px] text-error transition-colors hover:bg-error-bg"
      role="menuitem"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Déconnexion
    </button>
  </div>
</header>

<script>
  import { API_URL } from "../lib/api";
  import { POLL_INTERVALS } from "../lib/constants";

  // --- User menu ---
  const userTrigger = document.getElementById("user-menu-trigger");
  const userDropdown = document.getElementById("user-dropdown");

  function toggleUserMenu(open: boolean) {
    if (!userDropdown) return;
    if (open) {
      userDropdown.classList.remove("invisible", "opacity-0", "translate-y-1");
      userDropdown.classList.add("visible", "opacity-100", "translate-y-0");
    } else {
      userDropdown.classList.add("invisible", "opacity-0", "translate-y-1");
      userDropdown.classList.remove("visible", "opacity-100", "translate-y-0");
    }
  }

  let userMenuOpen = false;
  userTrigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    userMenuOpen = !userMenuOpen;
    toggleUserMenu(userMenuOpen);
  });

  document.addEventListener("click", (e) => {
    if (userMenuOpen && !userDropdown?.contains(e.target as Node)) {
      userMenuOpen = false;
      toggleUserMenu(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && userMenuOpen) {
      userMenuOpen = false;
      toggleUserMenu(false);
    }
  });

  // --- Load user info from session ---
  function loadUserInfo() {
    const raw = sessionStorage.getItem("gsie_admin_session");
    if (!raw) return;
    try {
      const s = JSON.parse(raw);
      const username = s.username || s.user?.username || "admin";
      const roles = s.roles || s.user?.roles || ["user"];
      const initials = username.slice(0, 2).toUpperCase();

      const avatar = document.getElementById("user-avatar");
      const nameEl = document.getElementById("user-name");
      const ddName = document.getElementById("dd-user-name");
      const ddRole = document.getElementById("dd-user-role");

      if (avatar) avatar.textContent = initials;
      if (nameEl) nameEl.textContent = username;
      if (ddName) ddName.textContent = username;
      if (ddRole) ddRole.textContent = roles.join(", ");
    } catch {
      // ignore
    }
  }
  loadUserInfo();

  // --- Topbar search → Cmd+K ---
  document.getElementById("topbar-search")?.addEventListener("click", () => {
    document.dispatchEvent(new KeyboardEvent("keydown", { key: "k", metaKey: true, ctrlKey: true }));
  });

  // --- Clock ---
  function updateClock() {
    const el = document.getElementById("topbar-clock");
    if (!el) return;
    const now = new Date();
    el.textContent = now.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  }
  updateClock();
  const clockInterval = setInterval(updateClock, POLL_INTERVALS.clock);

  // --- API status ---
  async function checkApiStatus() {
    const label = document.getElementById("topbar-api-label");
    const pill = document.getElementById("topbar-api-status");
    if (!label || !pill) return;
    try {
      const resp = await fetch(`${API_URL}/health`);
      if (resp.ok) {
        const data = await resp.json();
        label.textContent = data.status === "healthy" ? "OK" : data.status;
        const dot = pill.querySelector("span");
        if (dot) dot.className = "h-1.5 w-1.5 rounded-full bg-accent";
        pill.className = "flex items-center gap-1.5 rounded-md border border-accent/30 bg-accent/5 px-2 py-0.5 text-[11px] text-accent";
      } else {
        label.textContent = "degraded";
        const dot = pill.querySelector("span");
        if (dot) dot.className = "h-1.5 w-1.5 rounded-full bg-warning";
      }
    } catch {
      label.textContent = "down";
      const dot = pill.querySelector("span");
      if (dot) dot.className = "h-1.5 w-1.5 rounded-full bg-error";
      pill.className = "flex items-center gap-1.5 rounded-md border border-error/30 bg-error-bg px-2 py-0.5 text-[11px] text-error";
    }
  }
  checkApiStatus();
  const apiStatusInterval = setInterval(checkApiStatus, POLL_INTERVALS.apiStatus);

  // --- Cleanup des intervals (SPA-like) ---
  window.addEventListener("beforeunload", () => {
    clearInterval(clockInterval);
    clearInterval(apiStatusInterval);
  });

  // --- Theme toggle (dropdown) ---
  const ddThemeToggle = document.getElementById("dd-theme-toggle");
  const ddThemeLabel = document.getElementById("dd-theme-label");
  const ddIconMoon = document.getElementById("dd-icon-moon");
  const ddIconSun = document.getElementById("dd-icon-sun");

  function applyTheme(theme: string) {
    const html = document.documentElement;
    if (theme === "light") {
      html.classList.remove("dark");
      html.classList.add("light");
      ddIconMoon?.classList.add("hidden");
      ddIconSun?.classList.remove("hidden");
      if (ddThemeLabel) ddThemeLabel.textContent = "Thème clair";
    } else {
      html.classList.remove("light");
      html.classList.add("dark");
      ddIconSun?.classList.add("hidden");
      ddIconMoon?.classList.remove("hidden");
      if (ddThemeLabel) ddThemeLabel.textContent = "Thème sombre";
    }
  }

  const savedTheme = localStorage.getItem("gsie-theme") || "dark";
  applyTheme(savedTheme);

  ddThemeToggle?.addEventListener("click", () => {
    const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
    const next = current === "dark" ? "light" : "dark";
    localStorage.setItem("gsie-theme", next);
    applyTheme(next);
  });

  // --- Logout (dropdown) ---
  document.getElementById("dd-logout")?.addEventListener("click", () => {
    sessionStorage.removeItem("gsie_admin_session");
    window.location.href = "/login";
  });
</script>

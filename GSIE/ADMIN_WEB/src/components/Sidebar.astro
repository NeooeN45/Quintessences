---
// Sidebar style Vercel/Geist : minimaliste, pure black, hairline borders,
// statut API en footer, pas de décorations.
// Responsive : hamburger sur mobile, fixe sur desktop.
import NotificationCenter from "./NotificationCenter.tsx";
import { API_URL } from "../lib/api";
import { POLL_INTERVALS } from "../lib/constants";
const { currentPath = "/" } = Astro.props;

const navGroups = [
  {
    label: "Monitoring",
    items: [
      { label: "Vue d'ensemble", href: "/", icon: "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3" },
      { label: "Santé système", href: "/health", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
      { label: "Activité", href: "/activity", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    ],
  },
  {
    label: "Données",
    items: [
      { label: "Ressources", href: "/resources", icon: "M4 6h16M4 12h16M4 18h16" },
      { label: "Connaissances", href: "/knowledge", icon: "M12 6.253v13m0-13C10.121 4.834 7.5 4.5 5.5 4.5c-1.5 0-3 .5-3 .5v13s1.5-.5 3-.5c2 0 4.621.334 6.5 1.753m0-13C13.879 4.834 16.5 4.5 18.5 4.5c1.5 0 3 .5 3 .5v13s-1.5-.5-3-.5c-2 0-4.621.334-6.5 1.753" },
      { label: "Climat", href: "/climate", icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" },
      { label: "Carte des risques", href: "/map", icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" },
    ],
  },
  {
    label: "Système",
    items: [
      { label: "Moteurs", href: "/engines", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
      { label: "Audit", href: "/audit", icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
      { label: "Engagement", href: "/gamification", icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" },
    ],
  },
];
---

<!-- Mobile hamburger -->
<button
  id="sidebar-toggle"
  aria-label="Ouvrir le menu"
  class="fixed left-4 top-4 z-50 flex h-9 w-9 items-center justify-center rounded-md border border-border bg-bg-100 text-fg-200 transition-colors hover:bg-bg-200 lg:hidden"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- Mobile overlay -->
<div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-black/60 backdrop-blur-sm lg:hidden"></div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r border-border bg-bg-100 transition-transform duration-300 lg:translate-x-0"
>
  <!-- Logo -->
  <div class="flex h-14 items-center gap-2.5 border-b border-border px-5">
    <div class="flex h-6 w-6 items-center justify-center rounded bg-accent text-xs font-bold text-white">
      G
    </div>
    <span class="text-sm font-semibold tracking-tight text-fg-100">GSIE</span>
    <div class="ml-auto flex items-center gap-2">
      <NotificationCenter client:idle />
      <span class="text-xs text-fg-500" id="api-version">v0.1.0</span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Navigation principale">
    <!-- Cmd+K hint -->
    <button
      id="cmdk-trigger"
      aria-label="Ouvrir la recherche (Cmd+K)"
      class="mb-3 flex w-full items-center gap-2.5 rounded-md border border-border bg-bg-200 px-3 py-1.5 text-[12px] text-fg-400 transition-colors hover:border-border-strong hover:text-fg-200"
    >
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      Rechercher…
      <kbd class="ml-auto rounded border border-border px-1 py-0.5 text-[10px] text-fg-500" aria-hidden="true">⌘K</kbd>
    </button>

    <ul class="space-y-0.5" role="list">
      {navGroups.map((group) => (
        <li class="mb-3" role="listitem">
          <div class="mb-1 px-3 text-[10px] font-semibold uppercase tracking-wider text-fg-500">
            {group.label}
          </div>
          <ul class="space-y-0.5" role="list">
            {group.items.map((item) => {
              const isActive = currentPath === item.href ||
                (item.href !== "/" && currentPath.startsWith(item.href));
              return (
                <li role="listitem">
                  <a
                    href={item.href}
                    aria-current={isActive ? "page" : undefined}
                    class={`group flex items-center gap-2.5 rounded-md px-3 py-1.5 text-[13px] transition-colors ${
                      isActive
                        ? "bg-bg-300 font-medium text-fg-100"
                        : "text-fg-300 hover:bg-bg-200 hover:text-fg-100"
                    }`}
                  >
                    <svg class={`h-4 w-4 ${isActive ? "text-fg-100" : "text-fg-500 group-hover:text-fg-300"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                    </svg>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Footer : session countdown only (theme + logout dans Topbar) -->
  <div class="border-t border-border p-3">
    <!-- Session countdown -->
    <div id="session-indicator" class="flex items-center gap-2 px-3 py-1 text-[11px] text-fg-400" role="status" aria-live="polite">
      <svg class="h-3.5 w-3.5 text-fg-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span id="session-time">Session: —</span>
    </div>
  </div>
</aside>

<div class="hidden w-60 flex-shrink-0 lg:block"></div>

<script>
  import { API_URL } from "../lib/api";
  import { POLL_INTERVALS } from "../lib/constants";

  // --- Mobile sidebar toggle ---
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sidebar-overlay");
  const toggle = document.getElementById("sidebar-toggle");

  function openSidebar() {
    sidebar?.classList.remove("-translate-x-full");
    overlay?.classList.remove("hidden");
  }
  function closeSidebar() {
    sidebar?.classList.add("-translate-x-full");
    overlay?.classList.add("hidden");
  }

  toggle?.addEventListener("click", openSidebar);
  overlay?.addEventListener("click", closeSidebar);

  // Fermer la sidebar mobile après navigation
  document.querySelectorAll("#sidebar a").forEach((a) => {
    a.addEventListener("click", () => {
      if (typeof window !== "undefined" && window.innerWidth < 1024) closeSidebar();
    });
  });

  // --- Session countdown ---
  function updateSessionCountdown() {
    const el = document.getElementById("session-time");
    if (!el) return;
    if (typeof window === "undefined") return;
    const raw = sessionStorage.getItem("gsie_admin_session");
    if (!raw) {
      el.textContent = "Session: —";
      el.parentElement?.classList.add("text-warning");
      return;
    }
    try {
      const s = JSON.parse(raw);
      const remaining = s.expiresAt - Date.now();
      if (remaining <= 0) {
        el.textContent = "Session expirée";
        el.parentElement?.classList.add("text-error");
        return;
      }
      const mins = Math.floor(remaining / 60000);
      const secs = Math.floor((remaining % 60000) / 1000);
      el.textContent = `Session: ${mins}:${secs.toString().padStart(2, "0")}`;
      // Warning < 2 min
      if (remaining < 120000) {
        el.parentElement?.classList.add("text-warning");
      } else {
        el.parentElement?.classList.remove("text-warning");
      }
    } catch {
      el.textContent = "Session: —";
    }
  }
  updateSessionCountdown();
  setInterval(updateSessionCountdown, POLL_INTERVALS.sessionCountdown);

  // --- API version (sidebar footer) ---
  async function loadApiVersion() {
    const vEl = document.getElementById("api-version");
    if (!vEl) return;
    try {
      const resp = await fetch(`${API_URL}/health`);
      if (resp.ok) {
        const data = await resp.json();
        if (data.version) vEl.textContent = `v${data.version}`;
      }
    } catch {
      // ignore
    }
  }
  loadApiVersion();

  // --- Cmd+K trigger ---
  document.getElementById("cmdk-trigger")?.addEventListener("click", () => {
    document.dispatchEvent(new KeyboardEvent("keydown", { key: "k", metaKey: true, ctrlKey: true }));
  });
</script>
